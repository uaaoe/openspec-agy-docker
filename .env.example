# -----------------------------------------------------------------------------
# Antigravity & OpenSpec Containerized Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env before starting the container:
#   cp .env.example .env
# -----------------------------------------------------------------------------

# --- Gemini Authentication for Antigravity CLI ---
# By default, Antigravity CLI reuses cached OAuth credentials mounted from
# ~/.gemini on your host machine (${HOME}/.gemini:/home/sandboxuser/.gemini:rw).
# If running headlessly or outside a desktop environment, provide your Gemini API key:
GEMINI_API_KEY=""

# --- Secondary / Third-Party AI Model Providers (Optional) ---
# Third-party keys are isolated and ingested exclusively via .env:
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Host User Identity Matching (Optional overrides) ---
# Automatically detected and populated by Makefile / create-agy-project.
# Defaults to 1000:1000 if omitted.
# UID=1000
# GID=1000
